{
    "manifest_version": 3,
    "name": "Guide 导航管理",
    "version": "1.0.0",
    "description": "管理个人导航站(guide)的地址：查看/修改/删除/快捷添加当前页，并可触发 git 提交与推送",
    "key": "",
    "minimum_chrome_version": "110",
    "permissions": [
        "nativeMessaging",
        "tabs",
        "contextMenus",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Guide 导航管理"
    },
    "icons": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    }
}
